function snapshotBase(over: Record<string, unknown> = {}) {
  return {
    formatVersion: 1,
    policyVersion: 1,
    adapterVersion: "wechat/1",
    html: "<p>hi</p>",
    css: "p{color:red}",
    hash: "h",
    account: "账号",
    author: "作者",
    publishedAt: 1700000000000,
    assets: [{ fileName: SNAP_FILE_A, sourceUrl: "https://mmbiz.qpic.cn/x", sha256: HASH_A, bytes: 3 }],
    failures: [],
    warnings: [],
    ...over,
  };
}

export async function buildWebSnapGolden() {
  const san = await import("../../apps/desktop/src/main/services/web-capture/snapshot-sanitize.ts");
  const doc = await import("../../apps/desktop/src/main/services/web-capture/snapshot-document.ts");
  const bridge = await import("../../apps/desktop/src/main/services/web-capture/snapshot-bridge.ts");
  const map = (url: string) => (ALLOWED.includes(url) ? url : undefined);

  const html = htmlCases.map((input) => {
    try {
      return { input, output: san.cleanHtml(input, map) };
    } catch (e) {
      return { input, error: String((e as Error).message) };
    }
  });
  const inline = cssInline.map((input) => ({ input, output: san.cleanCss(input, map, false) }));
  const sheet = cssSheet.map((input) => ({ input, output: san.cleanCss(input, map, true) }));

  const snapCases: { name: string; snapshot: unknown }[] = [
    { name: "valid", snapshot: snapshotBase() },
    { name: "validTwoAssets", snapshot: snapshotBase({ assets: [snapshotBase().assets[0], { fileName: SNAP_FILE_B, sourceUrl: "x", sha256: HASH_B, bytes: 1 }], html: `<p><img src="local-image://${SNAP_FILE_A}"><img src="local-image://${SNAP_FILE_B}"><img src="local-image://wechat-${"c".repeat(64)}.png"></p>`, css: `p{background:url(local-image://${SNAP_FILE_B})}` }) },
    { name: "badFormatVersion", snapshot: snapshotBase({ formatVersion: 2 }) },
    { name: "htmlNotString", snapshot: snapshotBase({ html: 1 }) },
    { name: "cssNotString", snapshot: snapshotBase({ css: null }) },
    { name: "tooBig", snapshot: snapshotBase({ html: "x".repeat(12 * 1024 * 1024 + 1) }) },
    { name: "tooBigSum", snapshot: snapshotBase({ html: "x".repeat(12 * 1024 * 1024 - 5), css: "y".repeat(10) }) },
    { name: "assetsNotArray", snapshot: snapshotBase({ assets: {} }) },
    { name: "tooManyAssets", snapshot: snapshotBase({ assets: Array.from({ length: 201 }, () => snapshotBase().assets[0]) }) },
    { name: "failuresNotArray", snapshot: snapshotBase({ failures: "x" }) },
    { name: "failureBad", snapshot: snapshotBase({ failures: [{ url: "x" }] }) },
    { name: "failureNull", snapshot: snapshotBase({ failures: [null] }) },
    { name: "failureOk", snapshot: snapshotBase({ failures: [{ url: "https://x", reason: "超时" }] }) },
    { name: "warningsBad", snapshot: snapshotBase({ warnings: [1] }) },
    { name: "warningsMissing", snapshot: (() => { const s = snapshotBase() as Record<string, unknown>; delete s.warnings; return s; })() },
    { name: "accountBad", snapshot: snapshotBase({ account: 1 }) },
    { name: "authorMissing", snapshot: (() => { const s = snapshotBase() as Record<string, unknown>; delete s.author; return s; })() },
    { name: "assetBadName", snapshot: snapshotBase({ assets: [{ fileName: "evil.png", sha256: HASH_A }] }) },
    { name: "assetBadSha", snapshot: snapshotBase({ assets: [{ fileName: SNAP_FILE_A, sha256: "zz" }] }) },
    { name: "assetNull", snapshot: snapshotBase({ assets: [null] }) },
    { name: "assetExtGif", snapshot: snapshotBase({ assets: [{ fileName: `wechat-${HASH_A}.gif`, sha256: HASH_A }] }) },
    { name: "assetExtSvg", snapshot: snapshotBase({ assets: [{ fileName: `wechat-${HASH_A}.svg`, sha256: HASH_A }] }) },
    { name: "dirtyHtml", snapshot: snapshotBase({ html: `<script>x</script><p onclick="x" style="color:red;position:fixed">a</p><img src="local-image://${SNAP_FILE_A}"><img src="https://x/y.png">`, css: `@import url(x);p{color:red;background:url(https://evil)}` }) },
    { name: "null", snapshot: null },
    { name: "undefinedField", snapshot: {} },
    { name: "extraFieldsKept", snapshot: snapshotBase({ cover: "c", extra: { a: 1 } }) },
  ];
  const sanitize = snapCases.map(({ name, snapshot }) => {
    try {
      return { name, snapshot, output: san.sanitizeSnapshot(snapshot as never) };
    } catch (e) {
      return { name, snapshot, error: String((e as Error).message) };
    }
  });

  const documents: unknown[] = [];
  for (const name of ["valid", "validTwoAssets", "dirtyHtml", "extraFieldsKept"]) {
    const snapshot = snapCases.find((c) => c.name === name)!.snapshot as never;
    documents.push({ name, instanceId: null, output: doc.snapshotDocument(snapshot) });
    documents.push({ name, instanceId: "inst-1", output: doc.snapshotDocument(snapshot, "inst-1") });
    documents.push({ name, instanceId: 'a"<&\'b', output: doc.snapshotDocument(snapshot, 'a"<&\'b') });
  }
  const escapes = ["", "a&b", "<>\"'", "&amp;", "中文"].map((input) => ({ input, output: doc.escapeSnapshotText(input) }));

  const hashCases = [
    snapshotBase(),
    snapshotBase({ assets: [{ fileName: "z", sha256: "2" }, { fileName: "a", sha256: "1" }] }),
    snapshotBase({ failures: [{ url: "u", reason: "r" }], publishedAt: null }),
    snapshotBase({ account: "中文\"", author: "<>" }),
  ].map((snapshot) => ({ snapshot, output: san.snapshotHash(snapshot as never) }));

  return {
    allowed: ALLOWED,
    html,
    inline,
    sheet,
    sanitize,
    documents,
    escapes,
    hashes: hashCases,
    bridge: bridge.SNAPSHOT_BRIDGE,
    bridgeHash: crypto.createHash("sha256").update(bridge.SNAPSHOT_BRIDGE).digest("base64"),
  };
}
