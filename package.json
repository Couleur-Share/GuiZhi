{
  "name": "guizhi-monorepo",
  "version": "0.28.0",
  "private": true,
  "description": "GuiZhi monorepo - local-first AI personal knowledge base",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Couleur-Share/GuiZhi.git"
  },
  "scripts": {
    "check:linux": "node scripts/wslc/check-linux.mjs",
    "check:linux:prepare": "node scripts/wslc/check-linux.mjs --prepare",
    "check:linux:reuse": "node scripts/wslc/check-linux.mjs --reuse",
    "check:linux:verify": "node scripts/wslc/check-linux.mjs --verify",
    "test:wslc": "node --test scripts/wslc/*.test.mjs",
    "build": "pwsh -NoProfile -File apps/desktop-go/scripts/build-shell.ps1",
    "lint": "pnpm lint:file-size && pnpm lint:i18n && pnpm --filter @guizhi/desktop lint",
    "lint:file-size": "node scripts/check-file-line-limits.mjs",
    "lint:file-size:report": "node scripts/check-file-line-limits.mjs --report",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:i18n:report": "node scripts/check-i18n.mjs --report",
    "format": "pnpm --filter @guizhi/desktop format",
    "test": "pnpm --filter @guizhi/desktop test",
    "test:validation": "node --test scripts/tests/desktop-validation-snapshot.test.mjs scripts/tests/isolated-go.test.mjs scripts/tests/reading-libraries.test.mjs scripts/tests/reading-libraries-build.test.mjs scripts/tests/package-size.test.mjs scripts/tests/check-i18n.test.mjs",
    "test:harmony": "node --test \"apps/capture-harmony/tests/*.test.cjs\"",
    "test:unit": "pnpm test:validation && pnpm --filter @guizhi/desktop test:unit && pnpm --filter @guizhi/desktop-go test",
    "test:run": "pnpm --filter @guizhi/desktop test:run",
    "shot": "node scripts/isolated-go.mjs shot",
    "test:release": "pnpm --filter @guizhi/desktop test:release",
    "typecheck": "pnpm -r typecheck",
    "verify:release": "node --experimental-strip-types scripts/verify-release.mts",
    "verify:release:quick": "node --experimental-strip-types scripts/verify-release.mts --profile quick",
    "build:installer": "pwsh -NoProfile -File apps/desktop-go/scripts/build-installer.ps1"
  }
}
