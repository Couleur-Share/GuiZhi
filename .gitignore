# ========================
# Monorepo root .gitignore
# ========================

# Re-include common source file extensions (overrides parent-level ignores)
!*.json
!*.yaml
!*.yml
!*.ts
!*.tsx
!*.js
!*.jsx
!*.css
!*.svg

# ========================
# Dependencies
# ========================
node_modules/
.pnpm-store/

# ========================
# Build output
# ========================
out/
dist/
build/
dist-electron/
release/
*.tgz

# ========================
# Lock files (pnpm only)
# ========================
package-lock.json
yarn.lock

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
.cursor/
*.swp
*.swo
.windsurfrules
.claude/
.agent/
.sisyphus/
文档/

# ========================
# OS
# ========================
.DS_Store
Thumbs.db

# ========================
# Logs
# ========================
*.log
npm-debug.log*
pnpm-debug.log*

# ========================
# Environment
# ========================
.env
.env.local
.env.*.local
.dev.vars
apps/web-cloudflare/.dev.vars
apps/web-cloudflare/.wrangler/
apps/web-cloudflare/scripts/*.local.txt

# Signing credentials
*.p8
*.p12
*.pfx
AuthKey_*.p8
DeveloperID*.p12
DeveloperID*.pfx

# ========================
# Test / Coverage
# ========================
coverage/
.nyc_output/
test-results/
playwright-report/
.playwright-cli/
output/playwright/

# ========================
# Cache
# ========================
.cache/
.codegraph/
.parcel-cache/
.eslintcache

# ========================
# Bundle analysis output
# ========================
apps/desktop/dist-stats/

# ========================
# Database (local dev databases)
# ========================
*.db
*.db.lock
*.sqlite
*.sqlite3
apps/web/data/
apps/web/data-first-run-*/
packages/db/src/index.js
packages/db/src/index.js.map
packages/shared/types/index.js
packages/shared/types/index.js.map

# ========================
# Temporary files
# ========================
*.tmp
*.temp
*.tsbuildinfo
# Python 字节码缓存（脚本与内置 worker 运行后生成，任意层级）
__pycache__/
.omx/
# 调试脚本与截图产物（.tmp-shots/、.tmp-ui-check.mjs 等）
.tmp-*
# 同上，但历史上有一批没带点前缀的（scripts/tmp-vad-ab.py、tmp-shots/）
tmp-*
# 抓下来对比发布 feed 的一次性产物
/atom.txt

# 任务验证产物（截图、基线快照、堆快照、临时 userData 等），仅本地留存，不入库
/artifacts/

# 手机收集的本地运行数据与凭证
deploy/capture/.env
deploy/capture/data/
deploy/capture/backups/
deploy/capture/secrets/
**/.machine/
apps/capture-web/test-results/
apps/capture-web/playwright-report/
apps/desktop/resources/crawl4ai/
config/crawl4ai/downloads/
