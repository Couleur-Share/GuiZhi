    {
      "name": "成功：L2 归一化，请求体与头，记 prompt_tokens",
      "config": {
        "id": "e1",
        "provider": "openai",
        "apiProtocol": "openai",
        "apiKey": "sk-emb",
        "apiUrl": "https://api.openai.com/v1",
        "model": "text-embedding-3-small"
      },
      "texts": [
        "第一段",
        "second <b> & \"q\"\n"
      ],
      "script": [
        {
          "body": "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[3,4]},{\"object\":\"embedding\",\"index\":1,\"embedding\":[1,0]}],\"usage\":{\"prompt_tokens\":12,\"total_tokens\":12}}"
        }
      ],
      "abort": null,
      "calls": 1,
      "expect": {
        "requests": [
          {
            "kind": "request",
            "method": "POST",
            "url": "https://api.openai.com/v1/embeddings",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer sk-emb"
            },
            "body": "{\"model\":\"text-embedding-3-small\",\"input\":[\"第一段\",\"second <b> & \\\"q\\\"\\n\"]}",
            "timeoutMs": 60000
          }
        ],
        "usage": [
          {
            "scenario": "embedding",
            "model": "text-embedding-3-small",
            "promptTokens": 12,
            "completionTokens": 0
          }
        ],
        "results": [
          [
            [
              0.6,
              0.8
            ],
            [
              1,
              0
            ]
          ]
        ],
        "errors": [
          null
        ]
      }
    },
