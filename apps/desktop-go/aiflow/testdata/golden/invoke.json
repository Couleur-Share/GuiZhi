    {
      "name": "onDelta 走流式，用量来自流末尾事件",
      "settings": {
        "aiModels": [
          {
            "id": "main",
            "provider": "openai",
            "apiProtocol": "openai",
            "apiKey": "sk-main",
            "apiUrl": "https://api.openai.com/v1",
            "model": "model-main",
            "capabilities": {
              "chat": true
            },
            "isDefault": true
          },
          {
            "id": "fast",
            "provider": "custom",
            "apiProtocol": "openai",
            "apiKey": "sk-fast",
            "apiUrl": "https://fast.example.com",
            "model": "model-fast",
            "capabilities": {
              "chat": true
            }
          }
        ],
        "modelRouteDefaults": {
          "mainText": "main",
          "fastText": "fast"
        }
      },
      "scenario": "qa",
      "options": {
        "stream": true,
        "maxTokens": 4096,
        "temperature": 0.2
      },
      "script": [
        {
          "chunks": [
            "data: {\"choices\":[{\"delta\":{\"content\":\"流\"}}]}\ndata: {\"choices\":[{\"delta\":{\"content\":\"式\"},\"finish_reason\":\"stop\"}]}\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":11,\"completion_tokens\":2}}\n"
          ]
        }
      ],
      "abort": null,
      "expect": {
        "requests": [
          {
            "kind": "stream",
            "method": "POST",
            "url": "https://api.openai.com/v1/chat/completions",
            "headers": {
              "Content-Type": "application/json",
              "Accept": "text/event-stream",
              "Authorization": "Bearer sk-main"
            },
            "body": "{\"model\":\"model-main\",\"messages\":[{\"role\":\"user\",\"content\":\"问\"}],\"temperature\":0.2,\"stream\":true,\"max_completion_tokens\":4096}",
            "timeoutMs": 120000
          }
        ],
        "usage": [
          {
            "scenario": "qa",
            "model": "model-main",
            "promptTokens": 11,
            "completionTokens": 2
          }
        ],
        "deltas": [
          "流",
          "式"
        ],
        "warnings": [],
        "result": {
          "content": "流式",
          "model": "model-main",
          "finishReason": "stop"
        },
        "error": null
      }
    },
