    {
      "name": "摘要走 fastText 模型，默认超时 120 秒，成功记 token",
      "settings": {
        "aiModels": [
          {
            "id": "main",
            "provider": "openai",
            "apiProtocol": "openai",
            "apiKey": "sk-main",
            "apiUrl": "https://api.openai.com/v1",
            "model": "model-main",
            "capabilities": {
              "chat": true
            },
            "isDefault": true
          },
          {
            "id": "fast",
            "provider": "custom",
            "apiProtocol": "openai",
            "apiKey": "sk-fast",
            "apiUrl": "https://fast.example.com",
            "model": "model-fast",
            "capabilities": {
              "chat": true
            }
          }
        ],
        "modelRouteDefaults": {
          "mainText": "main",
          "fastText": "fast"
        }
      },
      "scenario": "summary",
      "options": {
        "temperature": 0.3,
        "maxTokens": 4096
      },
      "script": [
        {
          "body": "{\"choices\":[{\"message\":{\"content\":\"摘要结果\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":100,\"completion_tokens\":20}}"
        }
      ],
      "abort": null,
      "expect": {
        "requests": [
          {
            "kind": "request",
            "method": "POST",
            "url": "https://fast.example.com/v1/chat/completions",
            "headers": {
              "Content-Type": "application/json",
              "Accept": "application/json",
              "Authorization": "Bearer sk-fast"
            },
            "body": "{\"model\":\"model-fast\",\"messages\":[{\"role\":\"user\",\"content\":\"问\"}],\"temperature\":0.3,\"stream\":false,\"max_tokens\":4096}",
            "timeoutMs": 120000
          }
        ],
        "usage": [
          {
            "scenario": "summary",
            "model": "model-fast",
            "promptTokens": 100,
            "completionTokens": 20
          }
        ],
        "deltas": [],
        "warnings": [],
        "result": {
          "content": "摘要结果",
          "model": "model-fast",
          "finishReason": "stop"
        },
        "error": null
      }
    },
